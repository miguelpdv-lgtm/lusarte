# Variables de la app. En GoDaddy NO se sube este archivo: se configuran en la interfaz
# de Node.js Hosting (Secrets / variables de entorno).

# Base de datos — GoDaddy las inyecta solas (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD).
# En desarrollo local se usa una sola URL: mysql://usuario:clave@host:puerto/base
DATABASE_URL=mysql://lusarte:lusarte-dev@127.0.0.1:3307/lusarte

# Secreto para firmar la sesión del panel (32+ caracteres aleatorios). OBLIGATORIO en GoDaddy.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Carpeta de las fotos subidas desde el panel. Por defecto public/assets/uploads (la que GoDaddy
# conserva entre publicaciones). En local: .local/uploads
# En GoDaddy NO la pongas (o pon public/assets/uploads): cualquier otra carpeta se borra con cada zip nuevo.
UPLOADS_DIR=.local/uploads

# API key del usuario de Effi (Administración → Usuarios → Ver más detalles). Vence a los 360 días.
# El usuario necesita permisos sobre: Artículos (consultar/modificar), Artículos - Stock disponible,
# Remisiones de venta (consultar/crear), Clientes (consultar/crear) y Tablas maestras (consultar).
EFFI_API_KEY=
# Remisiones automáticas en Effi por cada pedido pagado. Por defecto solo con Wompi en producción (pub_prod_…).
# "siempre" las fuerza (también con llaves de prueba: crea ventas reales); "nunca" las apaga.
EFFI_REMISIONES=
# Artículo de servicio de Effi para la comisión del pago en línea (desde 150.000). Vacío = el del domicilio (492)
EFFI_ARTICULO_COMISION=


# Wompi (pagos). Dashboard de Wompi → Desarrolladores. Empieza con las llaves de PRUEBAS (sandbox):
# pub_test_… y los secretos test_integrity_… / test_events_…. Sin WOMPI_PUBLIC_KEY ni WOMPI_INTEGRITY_SECRET
# el checkout queda apagado y el carrito ofrece pedir por WhatsApp.
# URL de eventos a configurar en Wompi: https://<dominio>/api/wompi/webhook
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Correos con Brevo (transaccionales). Brevo → SMTP y API → API Keys → "Generate a new API key".
# Sin BREVO_API_KEY los correos no salen: el panel los muestra como "Brevo sin configurar" y se pueden reenviar luego.
# El dominio del remitente debe estar autenticado en Brevo (DKIM + DMARC): ver docs/CORREOS.md.
BREVO_API_KEY=
EMAIL_FROM=pedidos@lusarte.net
EMAIL_FROM_NAME=Lusarte
# A dónde llegan las respuestas de los clientes (opcional; por defecto, al remitente)
EMAIL_REPLY_TO=
# Quién recibe el aviso de venta nueva (varios separados por coma)
ADMIN_EMAIL=
# URL pública para los enlaces e imágenes de los correos (en previews de Vercel, la URL del preview)
PUBLIC_SITE_URL=https://lusarte.net

# Datos legales del negocio para el comprobante de venta en PDF (no van en el código: el repo es público).
BUSINESS_LEGAL_NAME=
BUSINESS_NIT=
BUSINESS_REGIME=
BUSINESS_ADDRESS=
# Opcional: correo de contacto para términos, privacidad y comprobante (Lusarte no tiene; se atiende por WhatsApp)
BUSINESS_EMAIL=

# SEO. Google indexa el sitio solo con las llaves de producción de Wompi. SEO_INDEX=1 lo fuerza, SEO_INDEX=0 lo apaga.
SEO_INDEX=
# Código de verificación de Google Search Console (método "Etiqueta HTML": solo el valor de content="…")
GOOGLE_SITE_VERIFICATION=
