# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# herramientas locales
.claude/

# archivos fuente editables de la marca (.ai/.pdf/PNG originales): no se publican en el repo
/brand/originales/

# base de datos y archivos locales de desarrollo (MySQL portable, uploads)
/.local/
/public/assets/uploads/

# zips de despliegue sueltos
/*.zip
