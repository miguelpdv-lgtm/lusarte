# Copia este archivo a .env.local (desarrollo) o configura las variables en el panel del hosting.

# MySQL: mysql://usuario:contraseña@host:puerto/base
DATABASE_URL=mysql://lusarte:lusarte-dev@127.0.0.1:3307/lusarte

# Secreto para firmar la sesión del panel (32+ caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Carpeta donde se guardan las fotos subidas desde el panel.
# Debe sobrevivir a los redeploys (en GoDaddy: dentro de /public/assets/).
UPLOADS_DIR=.local/uploads
